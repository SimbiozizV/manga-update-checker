{
  "name": "Manga update checker",
  "description": "Проверка обновлений манги",
  "manifest_version": 3,
  "icons": {
    "16": "gray.png",
    "32": "gray.png",
    "48": "gray.png",
    "128": "gray.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Manga update checker - проверка обновлений манги"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
    "background": {
        "service_worker": "background.js"
    },
  "host_permissions": [
    "*://readmanga.live/*",
    "*://2.mintmanga.one/*",
    "*://selfmanga.live/*",
    "*://1.seimanga.me/*",
    "*://zz.readmanga.io/*",
    "*://web.usagi.one/*",
    "*://mangalib.me/*",
    "*://mangalib.org/*",
    "*://api2.mangalib.me/*",
    "*://cover.imglib.info/*",
    "*://cover.cdnlibs.org/*",
    "*://acomics.ru/*",
    "*://desu.me/*",
    "*://xn--80aaig9ahr.xn--c1avg/*",
    "*://remanga.org/*",
    "*://api.xn--80aaig9ahr.xn--c1avg/*",
    "*://manga.ovh/*",
    "*://api.manga.ovh/*",
    "*://inkstory.me/*",
    "*://com-x.life/*",
    "*://mangabuff.ru/*"
  ]
}
